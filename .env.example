# Browser-visible values only; never put secrets in VITE_ variables.
VITE_API_BASE_URL=https://localhost:7001/api/v1
VITE_ENTRA_CLIENT_ID=
VITE_ENTRA_TENANT_ID=

# Server configuration
ConnectionStrings__AppDb=
Azure__StorageAccountUrl=
Azure__PhotoContainer=field-item-photos
AzureOpenAI__Endpoint=
AzureOpenAI__DeploymentName=
AzureOpenAI__ApiVersion=
Authentication__TenantId=
Authentication__Audience=
Application__MaxPhotoBytes=12582912
Application__AiAnalysisTimeoutSeconds=60
# CIDR ranges of trusted reverse proxies (for example the platform ingress); add __1, __2 for more.
ForwardedHeaders__KnownNetworks__0=

# Local Docker Compose only. Use a local secret store; never commit a real value.
FIELDAPP_SQL_PASSWORD=
FIELDAPP_STORAGE_ACCOUNT_URL=
FIELDAPP_PHOTO_CONTAINER=field-item-photos
FIELDAPP_AZURE_OPENAI_ENDPOINT=
FIELDAPP_AZURE_OPENAI_DEPLOYMENT=
